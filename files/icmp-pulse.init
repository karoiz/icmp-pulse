#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# procd init script for icmp-pulse

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/icmp-pulse

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" -c /etc/config/icmp-pulse
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "icmp-pulse"
}
