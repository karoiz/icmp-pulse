config icmp-pulse 'main'
	# server IP address or name (IPv4)
	option server '203.0.113.10'
	# send interval in seconds
	option interval '10'
	# router name shown on the server; defaults to the hostname, max 16 characters
	# option router_id 'shop-krakow'
	# 32-byte key (64 hex characters), unique per router; generate: icmp-pulse --genkey
	# without a key packets are sent unencrypted (for testing only)
	# option key '...'

# Interfaces: Linux device names (ls /sys/class/net), max 15 characters.
# probe '1' = send a separate packet through this uplink (SO_BINDTODEVICE).
# Without any probed interface one packet per cycle follows normal routing.
# Without any interface section only system data is reported.

config interface
	# PPPoE session: probe, RTT, IP traffic
	option device 'pppoe-wan'
	option probe '1'

config interface
	# physical port below PPPoE: link state, speed, errors
	option device 'eth1'

config interface
	# LTE backup uplink; a less frequent probe saves data
	option device 'wwan0'
	option probe '1'
	option probe_interval '60'
